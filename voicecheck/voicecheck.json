 "tells": {
  "dash": {
   "name": "Em or en dash",
   "kind": "policy",
   "why": "House rule: no em or en dash in anything that leaves the house (also as an HTML entity, an escape, \"--\" or a look-alike). This is a policy check, not evidence of who wrote the text: Jesper's own 2021 captions have en dashes.",
   "fix": "Use a comma, a full stop, or restructure the sentence. Never a long dash.",
   "languages": [
    "en",
    "da",
    "und"
   ],
   "hard": true,
   "detector": "dash"
  },
  "hidden_char": {
   "name": "Invisible character inside a word",
   "kind": "policy",
   "why": "A soft hyphen, zero-width joiner or similar sits inside a word. It hides the word from every check and can break on the page. The check read the word without it.",
   "fix": "Retype the word, or paste it as plain text.",
   "languages": [
    "en",
    "da",
    "und"
   ],
   "hard": true,
   "detector": "hidden_char"
  },
  "mixed_script": {
   "name": "Look-alike letters (Cyrillic or Greek in a Latin word)",
   "kind": "policy",
   "why": "A word mixes Latin letters with Cyrillic or Greek ones that look the same. Nobody types that; it is how text gets past a filter. The check read the word as Latin.",
   "fix": "Retype the word on a normal keyboard.",
   "languages": [
    "en",
    "da",
    "und"
   ],
   "hard": true,
   "detector": "mixed_script"
  },
  "not_not_z": {
   "name": "Not X. Not Y. Z.",
   "kind": "signature",
   "why": "Two short \"Not ...\" sentences and then the reveal. The device viewers named on the Festool video. Jesper never does it: 0 in 33,000 words of his scripts.",
   "fix": "Say what it is, once, in one sentence. If the contrast matters, keep it inside that sentence the way he does (\"That's not one of the bad things, but the SD card went bonkers\").",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "not_not_z"
  },
  "reframe": {
   "name": "It isn't X. It's Y.",
   "kind": "signature",
   "why": "The reframe: says what something is by first saying what it is not, as a reveal (\"That's not a YouTube format. That's what we've been doing for ten thousand years.\").",
   "fix": "State the thing directly. Jesper's rare \"it's not\" lines are literal, not a reveal (\"It's not a very difficult joint, but there are soo many of them\").",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "reframe"
  },
  "in_the_way": {
   "name": "in the way that / the way X does",
   "kind": "signature",
   "why": "A comparison frame Claude uses to sound considered (\"it works in the way that a good plane works\"). The ordinary \"in a way that made it clear\" is not counted.",
   "fix": "Say the comparison plainly, or drop it.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\bin the way (?:that|which|only)\\b|\\bthe way (?:that )?(?:the|a|an|old|good|real|only|every|most) [\\w'-]+(?: [\\w'-]+)? (?:do|does|did|had|have|has|used to|would|always)\\b",
    "flags": "i"
   }
  },
  "every_single": {
   "name": "every single",
   "kind": "signature",
   "why": "The crowned superlative Claude uses for emphasis (\"Every single one has my name stamped into it\").",
   "fix": "Say \"every\" or \"all of them\", or give the number.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\bevery single\\b",
    "flags": "i"
   }
  },
  "heres_the_thing": {
   "name": "Here's the thing / here's the part",
   "kind": "signature",
   "why": "A signpost that announces the point before making it. Zero in his pre-2023 VO.",
   "fix": "Make the point. If a turn is needed, use his plain connectors: \"but then\", \"so\", \"and also\".",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\bhere(?:'s| is) (?:the|what|where|why) (?:thing|deal|kicker|catch|problem|part|truth|secret|point|twist|bit|weird|funny|interesting|best|good|bad|real)\\b|\\bhere(?:'s| is) (?:the thing|what (?:matters|happened|I (?:learned|found|noticed)))\\b",
    "flags": "i"
   }
  },
  "genuinely": {
   "name": "genuinely / genuine",
   "kind": "signature",
   "why": "Claude's favourite sincerity word (\"is genuinely\": 1,021 hits vs 4 in human articles).",
   "fix": "Cut it, or say \"really\" the way he does.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\bgenuine(?:ly)?\\b",
    "flags": "i"
   }
  },
  "honest_frame": {
   "name": "I want to be honest / the honest answer",
   "kind": "signature",
   "why": "The writer narrating its own candour or care (\"I want to be careful here\", \"my honest advice is\"). Jesper flagged both by hand: \"no honest advice please\". His own bare \"honestly\" and \"to be honest\" are not counted: he uses them (11 times in the train split).",
   "fix": "Delete the frame and say the thing.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\b(?:in all honesty|(?:I'll|I will|let me) be (?:honest|frank|straight)(?: with you)?|I (?:want|have|need) to be (?:honest|clear|careful|upfront|transparent|straight)(?: here| about| with)?|the honest (?:answer|version|truth|reason)|my honest (?:advice|take|opinion|answer))\\b",
    "flags": "i"
   }
  },
  "stock_metaphor": {
   "name": "load-bearing / earns its keep",
   "kind": "signature",
   "why": "Claude's stock metaphors (Anthropic's own writing guide names \"earns its keep\").",
   "fix": "Say the literal thing: \"this part matters because\", or just the reason.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "stock_metaphor"
  },
  "salience": {
   "name": "this matters",
   "kind": "signature",
   "why": "Telling the listener that something matters instead of showing why (Arize's top Claude category). Not counted: \"the only thing that matters\" and \"it matters to me\", which he says.",
   "fix": "Show the consequence instead: what breaks, what it costs, what happens next.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "(?<!thing )(?<!things )\\b(?:this|that|it|which) (?:really |still |actually |also |genuinely |truly )?matters\\b(?!\\s+to\\b)|\\bmatters (?:because|more than|most)\\b|\\bwhat (?:really )?matters (?:is|here|most)\\b|\\b(?:that's|that is|this is) what (?:counts|matters)\\b",
    "flags": "i"
   }
  },
  "less_more": {
   "name": "less like X and more like Y / rather than merely",
   "kind": "signature",
   "why": "The comparative reframe (Graphite: \"less like a _ and more like\" 105x the human rate).",
   "fix": "Say what it is like, once.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\bless (?:like |about |of )?(?:a |an |the )?[\\w' -]{1,30}?,? (?:and |but )?more (?:like|about|of) \\w|\\brather than (?:merely|simply|just)\\b",
    "flags": "i"
   }
  },
  "discovery": {
   "name": "Staged discovery (\"the part I didn't expect\", \"nobody tells you\")",
   "kind": "signature",
   "why": "Staged epiphany: announcing a surprise or a secret before saying what it is (\"That's the part I didn't expect.\", \"Here's what nobody tells you\").",
   "fix": "Say what happened. If it surprised him, he says what he saw and lets that be the surprise.",
   "languages": [
    "en"
   ],
   "hard": false,
   "detector": "regex",
   "pattern": {
    "source": "\\b(?:the (?:thing|part|bit) (?:I|we) (?:didn't|did not|never) (?:expect|see coming|plan for)|what I (?:didn't|did not|never) expect|didn't expect to find|surprised me (?:the )?most|I didn't set out to|keep coming back to|can't stop thinking about|get (?:it|that) out of my head|(?:nobody|no one) (?:tells you|talks about|warns you)|the part nobody)\\b",
    "flags": "i"
   }
  },
  "da_ikke_ladder": {
   "name": "Ikke X. Ikke Y. Z.",
   "kind": "signature",
